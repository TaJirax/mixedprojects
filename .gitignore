*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
*.apk
*.aab
build/
local.properties

# --- Blue Knight Downloader (spoty) ---
# Build output and the one-file exe: 150 MB+, rebuilt by build_portable.ps1.
spoty/release/
spoty/build/
spoty/package/
spoty/__pycache__/
# Tools fetched at build time, not sources.
spoty/vendor/
# Whatever the app has downloaded, and the sessions it was given.
BlueKnightdownloader/
*cookies*.txt

# --- GWD ---
# Xray core AAR: 56 MB, fetched by fetch-core.sh.
GWD/app/libs/*.aar
# Source drops, not the source of truth.
GWD*.zip

# --- Blue Knight Downloader: Android ---
# FFmpeg/FFprobe cross-compiled by build_ffmpeg_android.sh (~50 MB), and the
# engine + web files copied in from spoty/ at build time. All reproducible.
spoty/android/app/src/main/jniLibs/
spoty/android/app/src/main/assets/
spoty/android/app/src/main/python/spotify_downloader.py
spoty/android/app/src/main/python/blueknight_paths.py
spoty/android/app/src/main/python/pyshell.py
spoty/android/app/src/main/python/__pycache__/
spoty/android/.ffmpeg-build/
spoty/android/out/
# Signing material must never be committed.
spoty/android/keystore.properties
spoty/android/*.keystore
